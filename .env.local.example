# Copy to .env.local (or .env) and fill in. Never commit real values. .env* files are gitignored.

# --- World ID sign-in (server side only, never prefixed with VITE_) ---
# From your World ID developer portal registration (https://auth.world.org).
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=
# Exact callback URL registered in the portal. The path must be /api/auth/world/callback.
# The app redirects back to this URL's origin, so use the public origin you open the app on
# (for example your ngrok URL or the Arc Studio preview URL), not localhost behind a tunnel.
WORLD_ID_REDIRECT_URI=https://YOUR-APP-HOST/api/auth/world/callback
# Random string of at least 32 characters that signs the app session cookie, for example: openssl rand -base64 48
WORLD_ID_SESSION_SECRET=

# --- Auth server (optional) ---
AUTH_SERVER_PORT=3001
# Where the auth server forwards signed-in claim requests: the X analytics bridge by default in this repo.
CRE_TRIGGER_URL=http://127.0.0.1:2003

# --- Claim app ---
VITE_CLAIM_RECEIVER=
VITE_ENCLAVE_PUBLIC_KEY=
VITE_X_ANALYTICS_EXTENSION_ID=
# Created by: bun cre-claim/scripts/make-enclave-key.ts (used by the CRE simulator)
ENCLAVE_PRIVATE_KEY=
